# Copy to .env (local) and set the same names in Vercel -> Project -> Settings -> Environment Variables.
# Placeholders only. Never commit a real .env.

# --- Browser-safe (Supabase) ---
# Use the *anon* public key only. NEVER put the service_role key anywhere in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Android app only (optional for the website) ---
# The public https address of the deployed backend that serves /api/ai-chat, with no path, for example https://your-site.example
# It is a web address, not a secret. Without it the Android app builds and runs, and the AI Assistant says it is not set up.
# In GitHub Actions set it as a repository VARIABLE (not a secret). See docs/ANDROID_BUILD.md.
# VITE_API_BASE_URL=

# --- Server-only AI settings (read only by the Vercel function api/ai-chat.js and api/_lib/ai/) ---
# NEVER add a VITE_ prefix to any of these: VITE_ variables are copied into the public website code.
# Leave GEMINI_API_KEY empty and the whole app still works ("AI not configured"); only AI screens are unavailable.
# gemini (default) | anthropic | openai | ollama | none
AI_PROVIDER=gemini
# Create a key in Google AI Studio. Usage is subject to Google's current API quotas and pricing.
GEMINI_API_KEY=
# A Gemini model ID from Google's model list. Empty = the documented default (gemini-3.1-flash-lite).
GEMINI_MODEL=
# Output tokens per AI answer (64-4000). Empty = default (2048 for Gemini).
AI_MAX_TOKENS=
# AI messages per user per 24 hours (1-1000). Empty = 100.
AI_DAILY_LIMIT=

# --- Only if you choose another provider instead of Gemini ---
# anthropic / openai: AI_API_KEY and optionally AI_MODEL.  ollama: AI_BASE_URL and AI_MODEL.
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# --- CORS (optional) ---
# Extra https origins allowed to call /api/ai-chat from another site, comma separated (a custom domain). The website itself,
# the Android app (https://localhost) and Vercel's own hostnames are already allowed. Never use *.
# AI_ALLOWED_ORIGINS=
